APP_ENV=development
APP_NAME=ST-NLP
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=
DB_DRIVER=postgresql+psycopg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stnlp
DB_USER=stnlp_user
DB_PASSWORD=stnlp_dev_password
POSTGRES_USER=stnlp_user
POSTGRES_PASSWORD=stnlp_dev_password
POSTGRES_DB=stnlp
SQL_ECHO=false

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-character-hex-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=st-nlp-api
JWT_AUDIENCE=st-nlp-client
# Google Cloud Console -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Pydantic Settings JSON array
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Report image storage (relative paths resolve from repository root)
REPORT_UPLOAD_DIR=backend/storage
REPORT_MAX_UPLOAD_SIZE_BYTES=5242880
REPORT_MAX_ATTACHMENTS=5

# Phase 13 packaged ML inference model
PREDICTION_BUNDLE_PATH=ml/artifacts/inference/best_model_bundle.joblib
