# Docker Compose / application
APP_ENV=development
APP_NAME=ST-NLP
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (inside the Docker network)
DB_DRIVER=postgresql+psycopg
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stnlp
DB_USER=stnlp_user
DB_PASSWORD=stnlp_dev_password
POSTGRES_USER=stnlp_user
POSTGRES_PASSWORD=stnlp_dev_password
POSTGRES_DB=stnlp
SQL_ECHO=false

# Local development secret only. Replace with a unique random value before deployment.
JWT_SECRET_KEY=stnlp-local-development-only-change-this-before-deployment-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=st-nlp-api
JWT_AUDIENCE=st-nlp-client

# Optional Google OAuth Web Client ID.
# Leave empty to inspect the portal without Google sign-in.
GOOGLE_CLIENT_ID=

# The portals and API share the same origin.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Persistent paths inside the API container.
REPORT_UPLOAD_DIR=/app/backend/storage
REPORT_MAX_UPLOAD_SIZE_BYTES=5242880
REPORT_MAX_ATTACHMENTS=5
PREDICTION_BUNDLE_PATH=/app/ml/artifacts/inference/best_model_bundle.joblib
